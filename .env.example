# =============================================================================
# Rothe-Transporte Website – Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control!
# =============================================================================

# Public URL of the site (no trailing slash)
SITE_URL=https://rothe-transporte.de

# Path to the SQLite database file (relative to repo root)
DB_PATH=data/database.sqlite

# Path to the uploads directory (relative to repo root)
UPLOADS_PATH=uploads

# Default admin credentials (change immediately after first login!)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe!2026

# Session lifetime in seconds (3600 = 1 hour)
SESSION_LIFETIME=3600

# Application environment: production | development
APP_ENV=production
