# Database (never commit)
data/database.sqlite
data/database.sqlite-shm
data/database.sqlite-wal

# Sessions
data/sessions/

# Backups (created by scripts/backup.sh)
backups/

# Generated OG image cache
data/og-cache/

# Installer artefacts (per-deployment, never commit)
data/install_token.txt
data/installed.lock

# Login attempts tracker
data/login_attempts.json

# Error log
data/php-errors.log

# Uploads – die Originalbilder gehoeren ab jetzt ins Repo
# (resize_uploads.php erzeugt daraus Web-Varianten unter
#  public/assets/images/from-original/, die nicht commited werden).
# Cache-/Temp-Dateien ausschliessen:
uploads/*.tmp
uploads/.DS_Store

# Vom Resize-Skript erzeugte Web-Varianten – pro Server neu generierbar
public/assets/images/from-original/

# Environment
.env

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor junk
*.swp
*.swo
*~
.idea/
.vscode/

# Build artefacts / runtime
data/mirror.log
data/admin-build.log
